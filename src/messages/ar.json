  "about": {
    "title": "حول نظام استشارات العقارات",
    "welcome": "مرحبًا بك في نظام استشارات العقارات الشامل. مع أكثر من عقد من الخبرة في معاملات العقارات، نحن رواد في تقديم الخدمات الحديثة والذكية في صناعة العقارات. هدفنا هو إنشاء منصة آمنة وشفافة وفعالة لجميع أصحاب المصلحة في هذا المجال.",
    "description": "في عالم اليوم حيث السرعة والدقة لها أهمية خاصة، قمنا بتبسيط عملية شراء وبيع وإيجار العقارات لك من خلال استخدام التقنيات الحديثة.",
    "benefits": {
      "title": "فوائد العمل معنا",
      "items": [
        "الوصول إلى قاعدة بيانات شاملة للعقارات في جميع أنحاء البلاد",
        "استشارة متخصصة مجانية في جميع المراحل",
        "تسجيل وإدارة الإعلانات بذكاء",
        "نظام مطابقة ذكي للطلبات مع العقارات المتاحة",
        "دعم على مدار الساعة من قبل المتخصصين ذوي الخبرة",
        "ضمان أمان ودقة المعلومات المسجلة"
      ]
    },
    "commitments": {
      "title": "التزاماتنا",
      "items": [
        "الشفافية الكاملة في تقديم المعلومات والأسعار",
        "حماية خصوصية وأمان معلومات المستخدمين",
        "التحديث المستمر للمعلومات والأسعار",
        "تقديم استشارة متخصصة من قبل المستشارين الخبراء",
        "المتابعة المستمرة لطلبات المستخدمين",
        "ضمان عدالة المعاملات"
      ]
    },
    "vision": {
      "title": "رؤيتنا",
      "items": [
        "توسيع الخدمات الذكية في قطاع العقارات",
        "إنشاء منصة آمنة للاستثمار في سوق الإسكان",
        "تطوير خدمات استشارات العقارات عبر الإنترنت",
        "استخدام التقنيات الحديثة في معاملات العقارات",
        "توسيع شبكة الشركاء في جميع أنحاء البلاد",
        "رفع معايير خدمات العقارات"
      ]
    }
